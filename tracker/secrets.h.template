// secrets.h — Copy this file to secrets.h and fill in your values.
//             Never commit secrets.h to git (it is listed in .gitignore).
#pragma once

// ---------------------------------------------------------------------------
//  Wi-Fi credentials
//  SSID1 / SSID1_PASSWORD  → primary campus IoT network (IITR-IoT)
//  SSID2 / SSID2_PASSWORD  → backup mobile hotspot
// ---------------------------------------------------------------------------
#define SSID1          "IITR-IoT"
#define SSID1_PASSWORD "your_iitr_iot_password"

#define SSID2          "YourHotspotName"
#define SSID2_PASSWORD "YourHotspotPassword"

// ---------------------------------------------------------------------------
//  Flask server endpoint
//  Set to your server's IP or hostname.  Include the full path with port.
//  Example (HTTP dev): "http://192.168.1.42:8000/api/telemetry"
//  Example (HTTPS):    "https://tracker.example.com/api/telemetry"
// ---------------------------------------------------------------------------
#define API_URL        "http://YOUR_SERVER_IP:8000/api/telemetry"

// ---------------------------------------------------------------------------
//  Device authentication token (sent as: Authorization: Bearer <token>)
//  Must be at least 32 characters.  Generate with: openssl rand -hex 32
// ---------------------------------------------------------------------------
#define DEVICE_TOKEN   "your_device_token_at_least_32_chars"

// ---------------------------------------------------------------------------
//  TLS / HTTPS
//  ROOT_CA : PEM-encoded CA certificate string (paste inside the R"cert(...)cert").
//            Leave as empty string "" when using plain HTTP (dev only).
//  ALLOW_LAN_HTTP : set true to allow plain http:// URLs (useful on LAN).
//                   Set false in production when using https://.
// ---------------------------------------------------------------------------
#define ROOT_CA        ""
#define ALLOW_LAN_HTTP true

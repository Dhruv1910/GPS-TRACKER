#include <Wire.h>
#include <Adafruit_Sensor.h>
#include <Adafruit_BNO055.h>
#include <TinyGPSPlus.h>
#include <ArduinoJson.h>

// BNO055
Adafruit_BNO055 bno = Adafruit_BNO055(55, 0x28);

// GPS
TinyGPSPlus gps;
HardwareSerial GPSSerial(1);

// Pins
#define SDA_PIN D4
#define SCL_PIN D5
#define GPS_RX D6
#define GPS_TX D7

unsigned long lastSend = 0;

void setup() {
  Serial.begin(115200);

  // I2C initialization
  Wire.begin(SDA_PIN, SCL_PIN);

  // GPS initialization
  GPSSerial.begin(9600, SERIAL_8N1,
                  GPS_RX, GPS_TX);

  // BNO055 initialization
  if (!bno.begin()) {
    Serial.println("BNO055 NOT DETECTED!");
    while (1) delay(10);
  }

  bno.setExtCrystalUse(true);

  Serial.println("SMART VEHICLE SYSTEM READY");
}

void loop() {

  // Read GPS continuously
  while (GPSSerial.available()) {
    gps.encode(GPSSerial.read());
  }

  // Send readings every second
  if (millis() - lastSend >= 1000) {
    lastSend = millis();

    // Read acceleration
    imu::Vector<3> acc =
        bno.getVector(Adafruit_BNO055::VECTOR_ACCELEROMETER);

    // Read gyroscope
    imu::Vector<3> gyro =
        bno.getVector(Adafruit_BNO055::VECTOR_GYROSCOPE);

    // Read orientation
    imu::Vector<3> euler =
        bno.getVector(Adafruit_BNO055::VECTOR_EULER);

    // Create JSON
    StaticJsonDocument<512> doc;

    doc["device_id"] = "vehicle_01";

    doc["latitude"] =
        gps.location.isValid() ?
        gps.location.lat() : 0.0;

    doc["longitude"] =
        gps.location.isValid() ?
        gps.location.lng() : 0.0;

    doc["speed_kmph"] =
        gps.speed.isValid() ?
        gps.speed.kmph() : 0.0;

    doc["satellites"] =
        gps.satellites.isValid() ?
        gps.satellites.value() : 0;

    doc["gps_valid"] = gps.location.isValid();

    doc["acc_x"] = acc.x();
    doc["acc_y"] = acc.y();
    doc["acc_z"] = acc.z();

    doc["gyro_x"] = gyro.x();
    doc["gyro_y"] = gyro.y();
    doc["gyro_z"] = gyro.z();

    doc["roll"] = euler.x();
    doc["pitch"] = euler.y();
    doc["heading"] = euler.z();

    // Print JSON
    serializeJson(doc, Serial);
    Serial.println();
  }
}
